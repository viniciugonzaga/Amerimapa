# ─── Aplicação ────────────────────────────────────────────
APP_NAME=AmeriMapa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
BCRYPT_ROUNDS=12

# No Linux/Mac pode ativar (não funciona no Windows)
# PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=single
LOG_LEVEL=debug

# ─── Banco (MySQL do XAMPP/phpMyAdmin) ────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=amerimapa
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# ─── AmeriMapa ────────────────────────────────────────────
DEVICE_API_KEY=troque-esta-chave-do-esp32
HARDWARE_TIMEOUT_SECONDS=15
DEFAULT_DEVICE_ID=map-01
API_TOKEN_TTL_DAYS=7
SEED_ADMIN_EMAIL=admin@amerimapa.com
SEED_ADMIN_PASSWORD=amerimapa123
